# Generic function to read apsim output files. 
read.apsim <- function(apsim.name) {
  header<-readLines(apsim.name, n=25)
  if (length(header) == 0 ) {return(NULL)}
  
  i<-which(grepl("Date",header,fixed = T))
  apsim <- read.table(apsim.name,skip=i+1,na.strings=c("NA","?"))
  names(apsim) <- unlist(strsplit(trimws(header[i]), " +"))
  
  i<-which(grepl("factors",header,fixed = T))
  if (length(i) > 0) {
    x<-unlist(strsplit(substring(header[i], first = 11), ";"))
    factors<-as.data.frame(lapply(strsplit(x, "="), function(x) {x[2]}))
    names(factors)<-unlist(lapply(strsplit(x, "="), function(x) {x[1]}))
    return(cbind(factors, apsim))
  }
  return(apsim)
}

